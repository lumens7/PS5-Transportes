// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "./node_modules/@prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model cadastro_funcionario {
  id         Int    @id @default(autoincrement())
  nome       String
  cpf        Int
  turno      String
  alojamento String
}

model cadastro_alojamento {
  id         Int    @id @default(autoincrement())
  alojamento String
  cep        Int
  rua        String
  bairro     String
  numero     Int
}

model TB_GARAGEM {
  ID_GARAGEM   Int     @id @default(autoincrement())
  NOME_GARAGEM String?
  RUA          String?
  BAIRRO       String?
  NUMERO       Int?
  CEP          String?
}
